<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jefferson Driving School | Knysna</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
:root {
    --red: #c00000;
    --dark: #0f0f0f;
    --white: #ffffff;
    --yellow: #ffcc00;
    --gray: #f5f6f8;
}

/* RESET */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', system-ui, sans-serif;
    background: var(--white);
    color: #222;
    line-height: 1.6;
}

.container {
    max-width: 1200px;
    margin: auto;
    padding: 0 20px;
}

/* HEADER */
header {
    background: rgba(15,15,15,0.9);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
}

/* LOGO */
.logo {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 1.4rem;
    font-weight: 800;
    color: white;
}

.logo-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    background: white;
    padding: 4px;
    border-radius: 8px;
}

.logo-text {
    white-space: nowrap;
}

/* CONTACT */
.contact-info a {
    color: white;
    text-decoration: none;
    margin-left: 15px;
    font-weight: 600;
}

/* HERO */
.hero {
    background: url("https://raw.githubusercontent.com/nicholaskock33-tech/jefferson/main/ChatGPT%20Image%20Dec%2016,%202025,%2002_21_45%20AM.png")
    center/cover no-repeat;
    position: relative;
    padding: 140px 0;
}

.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        120deg,
        rgba(0,0,0,0.85),
        rgba(192,0,0,0.65)
    );
}

.hero-content {
    position: relative;
    max-width: 850px;
    margin: auto;
    text-align: center;
    color: white;
}

.hero h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 900;
    margin-bottom: 20px;
}

.hero p {
    font-size: 1.25rem;
    margin-bottom: 35px;
}

.cta-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    padding: 15px 35px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    font-size: 1.05rem;
    transition: 0.3s ease;
}

.btn-whatsapp {
    background: linear-gradient(135deg, #25D366, #1ebe5b);
    color: white;
}

.btn-call {
    background: rgba(255,255,255,0.15);
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
}

.btn:hover {
    transform: translateY(-3px);
}

/* SECTIONS */
section {
    padding: 80px 0;
}

.section-title {
    text-align: center;
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 50px;
}

/* SERVICES */
.services {
    background: var(--gray);
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 30px;
}

.service-card {
    background: white;
    border-radius: 18px;
    padding: 35px;
    text-align: center;
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    transition: 0.3s;
}

.service-card:hover {
    transform: translateY(-8px);
}

.service-icon {
    width: 70px;
    height: 70px;
    margin: auto auto 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--red), #ff4d4d);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
}

/* ABOUT */
.about p {
    max-width: 900px;
    margin: auto;
    text-align: center;
    font-size: 1.15rem;
}

/* GALLERY */
.gallery {
    background: var(--gray);
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 25px;
}

.gallery-grid img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 18px;
    box-shadow: 0 15px 30px rgba(0,0,0,0.15);
}

/* FOOTER */
footer {
    background: linear-gradient(135deg, #000, #111);
    color: white;
    padding: 50px 20px;
    text-align: center;
}

footer p {
    margin-bottom: 10px;
    font-weight: 600;
}

/* MOBILE */
@media (max-width: 480px) {
    .logo-text {
        font-size: 1.1rem;
    }
    .logo-img {
        width: 38px;
        height: 38px;
    }
}
</style>
</head>

<body>

<header>
<div class="container header-container">
    <div class="logo">
        <img 
            src="https://raw.githubusercontent.com/nicholaskock33-tech/jefferson/main/logo.png"
            alt="Jefferson Driving School Logo"
            class="logo-img"
        >
        <span class="logo-text">Jefferson Driving School</span>
    </div>
    <div class="contact-info">
        <a href="tel:0789016352">078 901 6352</a>
        <a href="https://wa.me/27789016352"><i class="fab fa-whatsapp"></i></a>
    </div>
</div>
</header>

<section class="hero">
<div class="hero-content">
    <h1>Trusted Driving School in Knysna</h1>
    <p>Code 8 & Code 10 • K53 Certified • Open 7 Days a Week</p>
    <div class="cta-buttons">
        <a href="https://wa.me/27789016352" class="btn btn-whatsapp">
            <i class="fab fa-whatsapp"></i> Book via WhatsApp
        </a>
        <a href="tel:0789016352" class="btn btn-call">
            <i class="fas fa-phone"></i> Call Now
        </a>
    </div>
</div>
</section>

<section class="services">
<div class="container">
<h2 class="section-title">We Specialise In</h2>
<div class="services-grid">
<div class="service-card"><div class="service-icon"><i class="fas fa-car"></i></div>Code 8 Driving Lessons</div>
<div class="service-card"><div class="service-icon"><i class="fas fa-truck"></i></div>Code 10 Driving Lessons</div>
<div class="service-card"><div class="service-icon"><i class="fas fa-chalkboard-teacher"></i></div>K53 Training</div>
<div class="service-card"><div class="service-icon"><i class="fas fa-user-graduate"></i></div>Learner Driver Training</div>
<div class="service-card"><div class="service-icon"><i class="fas fa-clipboard-check"></i></div>Learner Licence Preparation</div>
<div class="service-card"><div class="service-icon"><i class="fas fa-id-card"></i></div>Driver Licence Preparation</div>
</div>
</div>
</section>

<section class="about">
<div class="container">
<h2 class="section-title">About Us</h2>
<p>
A well-established driving school serving Knysna, Plettenberg Bay and Sedgefield.
Affordable, punctual and professional. Open Monday to Sunday, 7am – 7pm.
</p>
</div>
</section>

<section class="gallery">
<div class="container">
<h2 class="section-title">Our Happy Clients</h2>
<div class="gallery-grid">
<img src="https://placehold.co/600x400?text=Happy+Client">
<img src="https://placehold.co/600x400?text=Driving+Lesson">
<img src="https://placehold.co/600x400?text=Licence+Success">
<img src="https://placehold.co/600x400?text=Confidence+Built">
</div>
</div>
</section>

<footer>
<p>Jefferson Driving School • Knysna</p>
<p>Reliable • Affordable • Professional</p>
</footer>

</body>
</html>
